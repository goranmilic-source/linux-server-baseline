# {{ ansible_managed }}
# fail2ban settings for linux-server-baseline.
# Overrides jail.conf and jail.d/*.conf (fail2ban: last value wins).


[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
ignoreip = {{ fail2ban_ignore_ips | join(' ') }}
banaction = ufw

[sshd]
enabled = true
port    = ssh
